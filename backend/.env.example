OPENAI_API_KEY=sk-tu-clave-aqui

# Postgres en producción (ver SECURITY.md). En dev, sin estas, se usa SQLite.
# App: rol sin BYPASSRLS y que NO sea dueño de las tablas.
# DATABASE_URL=postgresql+asyncpg://app_user:CAMBIAR@host:5432/sous_prod
# Migraciones (alembic upgrade head): rol dueño del esquema.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://sous_owner:CAMBIAR@host:5432/sous_prod
# Rol al que la migración 004 concede EXECUTE sobre las funciones de auth.
# APP_DB_ROLE=app_user
